# Lumée 生产环境变量模板。
# ms env init lumee 会复制到 makeserver/secrets/lumee.env（只在本机），并自动生成带 @generate 的密钥。
# 改完后，下次 ms deploy 会自动上传到服务器；只改变量不改代码用 ms env push lumee。
# 注意：值里不要出现 $ 符号。

# ---- 域名（改成你自己的）----
# 平台根域名：平台首页 lumee.shop，店铺免费子域名 {handle}.lumee.shop
LUMEE_STOREFRONT_DOMAIN=lumee.shop
LUMEE_ADMIN_HOST=admin.lumee.shop
# 商家自定义域名 CNAME 指向这里
LUMEE_CNAME_TARGET=stores.lumee.shop
# 服务器公网 IP（显示给商家配置根域名 A 记录）；ms deploy 会自动填当前服务器 IP
LUMEE_SERVER_IP=@server_ip

APP_NAME=Lumee
APP_ENV=production
APP_KEY=@generate:laravel_key
APP_DEBUG=false
APP_URL=https://lumee.shop
LUMEE_ADMIN_URL=https://admin.lumee.shop
LUMEE_STOREFRONT_SCHEME=https
LUMEE_STOREFRONT_PORT=
LUMEE_DEFAULT_THEME=fresh
LUMEE_TEST_PAYMENTS=false
LUMEE_TEST_BILLING=false
LUMEE_TLS_ASK_TOKEN=@generate:hex32

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# 日志直接进 docker logs（ms logs lumee 查看）
LOG_CHANNEL=stderr
LOG_LEVEL=warning

# 数据库在同一个 compose 里（服务名 mysql）
DB_CONNECTION=mysql
DB_DATABASE=lumee_saas
DB_USERNAME=lumee
DB_PASSWORD=@generate:hex24
DB_ROOT_PASSWORD=@generate:hex24

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SANCTUM_STATEFUL_DOMAINS=admin.lumee.shop

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=file

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="no-reply@lumee.shop"
MAIL_FROM_NAME="Lumée"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ---- 支付 ----
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT=false
STRIPE_CONNECT_WEBHOOK_SECRET=

PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_MODE=live
PAYPAL_WEBHOOK_ID=

AIRWALLEX_CLIENT_ID=
AIRWALLEX_API_KEY=
AIRWALLEX_ENV=prod
AIRWALLEX_WEBHOOK_SECRET=

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

SEVENTEEN_TRACK_KEY=

# "Continue with Google" for shoppers (redirect URI: {APP_URL}/auth/google/callback)
GOOGLE_LOGIN_CLIENT_ID=
GOOGLE_LOGIN_CLIENT_SECRET=
