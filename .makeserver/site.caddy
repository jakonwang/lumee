# Lumée 站点：ms deploy 把 ${变量} 换成 secrets/<实例>.env 里的值，写到服务器 /srv/edge/sites/<实例>.caddy
# ${MS_PROJECT} 是实例名（lumee / lumee-staging），容器别名都带它，同一台服务器上不会冲突。
# lb_try_duration：滚动更新时新旧容器交接的几秒内，请求会自动重试，用户看不到报错。

# 商家后台：页面来自 admin 容器，/api 转给 Laravel
${LUMEE_ADMIN_HOST} {
	encode zstd gzip
	@api path /api/* /sanctum/*
	handle @api {
		reverse_proxy ${MS_PROJECT}-app:80 {
			lb_try_duration 10s
		}
	}
	handle {
		reverse_proxy ${MS_PROJECT}-admin:80 {
			lb_try_duration 10s
		}
	}
}

# 平台首页 + 所有店铺（免费子域名、商家自定义域名）。
# 没有被其他站点占用的域名都会进到这里，证书按需签发：签之前先问 Laravel 是否允许（见 global.caddy）。
# 注意：一台服务器上只能有一个项目使用 https:// 兜底站点。
https:// {
	tls {
		on_demand
	}
	# 签证书的询问接口只给 Caddy 用
	respond /internal/* 404
	reverse_proxy ${MS_PROJECT}-app:80 {
		lb_try_duration 10s
	}
}
