APP_NAME=Lumee
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=lumee_saas
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@lumee.shop"
MAIL_FROM_NAME="Lumée"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Lumée
LUMEE_STOREFRONT_DOMAIN=lumee.localhost
LUMEE_STOREFRONT_SCHEME=http
LUMEE_STOREFRONT_PORT=8000
LUMEE_ADMIN_URL=http://localhost:5280
LUMEE_DEFAULT_THEME=fresh
LUMEE_TEST_PAYMENTS=false
LUMEE_TEST_BILLING=false

# Custom domains + automatic HTTPS (see docs/https.md)
LUMEE_CNAME_TARGET=stores.lumee.shop
LUMEE_SERVER_IP=
LUMEE_TLS_ASK_TOKEN=

# Stripe (test keys from https://dashboard.stripe.com/test/apikeys)
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
# Stripe Connect: merchants get paid into their own Stripe accounts (see README)
STRIPE_CONNECT=false
STRIPE_CONNECT_WEBHOOK_SECRET=

# PayPal (REST app from https://developer.paypal.com/dashboard/applications; webhook URL: https://<platform host>/webhooks/paypal)
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_MODE=sandbox
PAYPAL_WEBHOOK_ID=

# Airwallex (webhook URL: https://<platform host>/webhooks/airwallex, event payment_intent.succeeded)
AIRWALLEX_CLIENT_ID=
AIRWALLEX_API_KEY=
AIRWALLEX_ENV=demo
AIRWALLEX_WEBHOOK_SECRET=

# Razorpay (India, INR stores: UPI / cards / netbanking)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Package tracking (17TRACK API v2.2; webhook URL: https://<platform host>/webhooks/17track)
SEVENTEEN_TRACK_KEY=

# "Continue with Google" for shoppers (redirect URI: {APP_URL}/auth/google/callback)
GOOGLE_LOGIN_CLIENT_ID=
GOOGLE_LOGIN_CLIENT_SECRET=
